// Database schema. See docs/definicao-do-projeto.md, section 6 (names there are in Portuguese;
// the code uses English). Only the auth tables exist so far; the project tables come with
// their features.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  inspector
  pm
  admin
}

enum Language {
  pt
  en
}

enum InviteTokenType {
  invite
  password_reset
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  /// Null until the invited user sets a password.
  passwordHash String?  @map("password_hash")
  role         Role
  language     Language @default(pt)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  sessions     Session[]
  inviteTokens InviteToken[]

  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  /// Hash of the refresh token; the token itself is never stored.
  refreshHash String    @unique @map("refresh_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model InviteToken {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  type      InviteTokenType
  tokenHash String          @unique @map("token_hash")
  expiresAt DateTime        @map("expires_at") @db.Timestamptz
  usedAt    DateTime?       @map("used_at") @db.Timestamptz
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("invite_tokens")
}
